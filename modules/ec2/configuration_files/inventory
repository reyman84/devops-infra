plugin: amazon.aws.aws_ec2

regions:
  - us-east-1

filters:
  instance-state-name: running
  "tag:Role":
    - dev
    - stage
#    - prod

hostnames:
  - private-dns-name

hostvars_prefix: ec2_

groups:
  dev: ec2_tags.Role == 'dev'
  stage: ec2_tags.Role == 'stage'
  prod: ec2_tags.Role == 'prod'